{
  "functions": {
    "api/pagina.js": { "includeFiles": "index.html", "maxDuration": 10 },
    "api/sitemap.js": { "maxDuration": 20 }
  },
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/p/:slug", "destination": "/api/pagina?tipo=p&slug=:slug" },
    { "source": "/c/:slug", "destination": "/api/pagina?tipo=c&slug=:slug" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=300, must-revalidate" }] },
    { "source": "/(llms.txt|robots.txt)", "headers": [{ "key": "Content-Type", "value": "text/plain; charset=utf-8" }] }
  ]
}
